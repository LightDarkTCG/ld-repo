{
  "entities": {
    "LoreCategory": {
      "title": "Lore Category",
      "description": "A category/tab for organizing Lore.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Category name, like 'Planetas' or 'Raças'" },
        "orderIndex": { "type": "number", "description": "Order to show the tabs" }
      },
      "required": ["name", "orderIndex"]
    },
    "LoreArticle": {
      "title": "Lore Article",
      "description": "An article within a lore category.",
      "type": "object",
      "properties": {
        "categoryId": { "type": "string", "description": "ID of the parent category" },
        "title": { "type": "string", "description": "Title of the lore entry" },
        "content": { "type": "string", "description": "Main text/markdown content" },
        "imageUrl": { "type": "string", "description": "Supporting image" },
        "videoUrl": { "type": "string", "description": "Supporting video" },
        "orderIndex": { "type": "number", "description": "Ordering within the category" }
      },
      "required": ["categoryId", "title", "content", "orderIndex"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Registered player profile authenticated via Google.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Display name from Google" },
        "email": { "type": "string", "description": "User Google email address" },
        "photoURL": { "type": "string", "description": "Google avatar URL" },
        "createdAt": { "type": "string", "description": "Timestamp when user was created" },
        "lastLoginAt": { "type": "string", "description": "Timestamp when user last logged in" }
      },
      "required": ["uid", "email"]
    },
    "UserAlbum": {
      "title": "User Card Album",
      "description": "Collection tracking containing quantities of owned cards.",
      "type": "object",
      "properties": {
        "cards": { "type": "object", "description": "Map of card codes to quantity and possession details" },
        "lastUpdated": { "type": "string", "description": "Timestamp of last modification" }
      }
    },
    "UserSavedDeck": {
      "title": "User Saved Deck",
      "description": "Custom deck created by a user and saved to the cloud.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique deck identifier" },
        "name": { "type": "string", "description": "Deck title" },
        "heroName": { "type": "string", "description": "Flagship hero name" },
        "mainDeckCodes": { "type": "array", "items": { "type": "string" }, "description": "List of main deck card codes" },
        "sideDeckCodes": { "type": "array", "items": { "type": "string" }, "description": "List of side deck card codes" },
        "cardCount": { "type": "number", "description": "Total cards in main deck" },
        "coverImageUrl": { "type": "string", "description": "Hero or flagship card art URL" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "name", "mainDeckCodes"]
    },
    "CollectorRankEntry": {
      "title": "Collector Rank Entry",
      "description": "Public collector leaderboard record for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase user UID" },
        "displayName": { "type": "string", "description": "Player nickname" },
        "email": { "type": "string", "description": "Player email" },
        "photoURL": { "type": "string", "description": "Avatar URL" },
        "uniqueCards": { "type": "number", "description": "Distinct cards owned" },
        "totalCopies": { "type": "number", "description": "Total physical copies owned" },
        "uniqueLegado": { "type": "number", "description": "Unique legacy cards" },
        "uniqueModerno": { "type": "number", "description": "Unique modern cards" },
        "specialCards": { "type": "number", "description": "Special cards owned" },
        "completionPercentage": { "type": "number", "description": "Completion % of game catalogue" },
        "updatedAt": { "type": "string", "description": "Timestamp of ranking sync" }
      },
      "required": ["userId", "displayName", "uniqueCards"]
    },
    "StoreOrder": {
      "title": "Store Order",
      "description": "Physical product or pre-order purchase made in the official Light Dark TCG store.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Order ID" },
        "orderNumber": { "type": "string", "description": "Readable order code (e.g. LD-2026-1234)" },
        "userId": { "type": "string", "description": "Firebase UID of the buyer if logged in" },
        "buyerName": { "type": "string", "description": "Full name of the buyer" },
        "buyerEmail": { "type": "string", "description": "Buyer email" },
        "buyerCpf": { "type": "string", "description": "Buyer CPF for shipping/PIX" },
        "buyerPhone": { "type": "string", "description": "Buyer WhatsApp phone" },
        "items": { "type": "array", "description": "Cart items purchased" },
        "subtotal": { "type": "number", "description": "Items subtotal in BRL" },
        "discountTotal": { "type": "number", "description": "Discount amount in BRL" },
        "shippingPrice": { "type": "number", "description": "Shipping cost in BRL" },
        "totalAmount": { "type": "number", "description": "Final order amount in BRL" },
        "paymentMethod": { "type": "string", "description": "pix or checkout_pro" },
        "paymentStatus": { "type": "string", "description": "pending, approved, rejected, or cancelled" },
        "orderStatus": { "type": "string", "description": "aguardando_pagamento, pago_preparando, pre_venda_reservado, enviado, entregue, cancelado" },
        "trackingCode": { "type": "string", "description": "Correios tracking code" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" },
        "updatedAt": { "type": "string", "description": "ISO update timestamp" }
      },
      "required": ["id", "orderNumber", "buyerName", "buyerEmail", "totalAmount", "paymentStatus", "orderStatus", "createdAt"]
    }
  },
  "firestore": {
    "loreCategories": {
      "schema": { "$ref": "#/entities/LoreCategory" },
      "description": "A collection of lore categories."
    },
    "loreArticles": {
      "schema": { "$ref": "#/entities/LoreArticle" },
      "description": "A collection of lore articles."
    },
    "users": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles indexed by UID."
    },
    "users/{userId}/album": {
      "schema": { "$ref": "#/entities/UserAlbum" },
      "description": "User card possession album."
    },
    "users/{userId}/savedDecks": {
      "schema": { "$ref": "#/entities/UserSavedDeck" },
      "description": "User saved decks collection."
    },
    "collectorsRanking": {
      "schema": { "$ref": "#/entities/CollectorRankEntry" },
      "description": "Public community ranking of top card collectors."
    },
    "storeOrders": {
      "schema": { "$ref": "#/entities/StoreOrder" },
      "description": "Official Light Dark TCG store orders, shipping calculations, and tracking codes."
    }
  }
}
