rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'viniciuspdiasuzumaki@gmail.com'
      );
    }

    // --- RECURSOS DO USUÁRIO (ÁLBUM E DECKS SALVOS) ---
    match /users/{userId} {
      // O usuário pode ler e gravar seu próprio perfil
      allow read, write: if isOwner(userId) || isAdmin();

      // Álbum pessoal de coleção
      match /album/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Wishlist pessoal / Cartas que procuro (leitura pública para exibição de perfil, gravação pelo dono)
      match /wishlist/{document=**} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }

      // Decks salvos na nuvem (leitura pública para cálculo das cartas mais populares da comunidade)
      match /savedDecks/{deckId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }

      // Histórico de Campeonatos e Torneios do Usuário
      match /championshipHistory/{historyId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Coleção comunitária de Wishlists para agregação de cartas mais procuradas
    match /communityWishlists/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Suporte para Collection Group queries de savedDecks em toda a comunidade
    match /{path=**}/savedDecks/{deckId} {
      allow read: if true;
    }

    // Coleção pública espelhada de decks salvos da comunidade
    match /communityDecks/{deckId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Ranking público de maiores colecionadores da comunidade
    match /collectorsRanking/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Torneios Compartilhados da Comunidade e Oficiais
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if request.auth != null;
    }

    // Solicitações de Verificação de Tiragem Rara no Álbum
    match /albumVerificationRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // --- CONTEÚDO PÚBLICO (SOMENTE ADMIN PODE EDITAR/CRIAR/DELETAR) ---
    match /customCards/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customArchetypes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /customCollections/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homeSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /loreCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /loreArticles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /loreUniverses/{universeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /loreCharacters/{characterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wbSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wbTabs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wbItems/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wbTimelineEvents/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /wbCosmicNodes/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos do Mercado Light Dark TCG
    match /storeOrders/{orderId} {
      allow read: if true;
      allow create: if (request.resource.data.customerName is string || request.resource.data.buyerName is string)
                    && (request.resource.data.userEmail is string || request.resource.data.buyerEmail is string)
                    && request.resource.data.totalAmount is number;
      allow update: if isAdmin() || (
        request.resource.data.totalAmount == resource.data.totalAmount
      );
      allow delete: if isAdmin();
    }

    // Anúncios de Cartas e Coleções da Comunidade no Mercado
    match /marketplaceListings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.price is number
                    && request.resource.data.price > 0;
      allow update, delete: if isAdmin() || (
        request.auth != null && resource.data.sellerId == request.auth.uid
      );
    }

    // Avaliações de Compradores sobre Vendedores no Mercado da Comunidade
    match /marketplaceSellerReviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.sellerId is string
                    && request.resource.data.sellerId != request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string;
      allow update, delete: if isAdmin() || (
        request.auth != null && resource.data.buyerId == request.auth.uid
      );
    }
  }
}


